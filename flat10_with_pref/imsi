mo_cbal_cpools.f90:    real(dp) :: excess_carbon
mo_cbal_cpools.f90:    real(dp) :: Cpool_green_pot, Cpool_woods_pot         !! values of potential carbon pools i.e. before accounting for N-limitation
mo_cbal_cpools.f90:    LOGICAL  :: with_Nitrogen        !! .FALSE.: only Carbon pools are updated; .TRUE.: in addition also Nitrogen pools are updated 
mo_cbal_cpools.f90:    LOGICAL  :: with_yasso           !! .FALSE.: cbalance model for litter and soil carbon is used; .TRUE.: yasso model is used 
mo_cbal_cpools.f90:       !! ============== NON-N-LIMITED CARBON AND NITROGEN ALLOCATION =========================================================
mo_cbal_cpools.f90:       C_2_litter_greenPool =  &                                     !! Maximally the whole carbon from the green pool is transfered
mo_cbal_cpools.f90:       Cpool_green = Cpool_green - C_2_litter_greenPool              !! This removes carbon from the green pool
mo_cbal_cpools.f90:       excess_carbon = max(0.0_dp,Cpool_green - Cpool_green_max)     !! If by the reduction of LAI the maximum value of the green
mo_cbal_cpools.f90:       C_2_litter_greenPool = C_2_litter_greenPool + excess_carbon   !!    excess C that has also to be shedded to the green litter
mo_cbal_cpools.f90:       Cpool_green = Cpool_green - excess_carbon                     !!    pool and also substracted from the green pool
mo_cbal_cpools.f90:          !!  Move shedded Carbon pro rata to crop harvest flux and to ag green litter pools
mo_cbal_cpools.f90:          !! Move shedded Carbon to ag green litter pools
mo_cbal_cpools.f90:       !! Move shedded Carbon to bg green litter pools
mo_cbal_cpools.f90:       !!    Some organic carbon of the reserve pool is always lost with mortality of plants. 
mo_cbal_cpools.f90:       Cpool_slow = Cpool_slow + d_Cpool_slow                 !! Remove respired Carbon (note the negative sign!)
mo_cbal_cpools.f90:       !! ============== START OF POTENTIAL PLANT-CARBON ALLOCATION TO ESTIMATE PLANT-N-DEMAND =================================
mo_cbal_cpools.f90:             Cpool_reserve = 0.0_dp                                    !! .. calling routine. Hence all Carbon from the reserve pool
mo_cbal_cpools.f90:          !! Growth of Wood Pool (structural carbon of living plants)
mo_cbal_cpools.f90:          excess_carbon = max(0.0_dp,Cpool_woods_pot-Max_C_content_woods)    !! .. but thereby the pool may get too large
mo_cbal_cpools.f90:          Cpool_woods_pot = Cpool_woods_pot - excess_carbon                  !! .. so that the excess carbon has once more to be 
mo_cbal_cpools.f90:          NPP_2_greenPool = NPP_2_greenPool + excess_carbon                  !! .. and instead made available to the green pool
mo_cbal_cpools.f90:          NPP_2_woodPool = NPP_2_woodPool - excess_carbon                    !! .. and the actual amount of NPP put to the wood pool
mo_cbal_cpools.f90:             excess_carbon =                                         &       !! .... Thereby it may happen that it gets larger than
mo_cbal_cpools.f90:                  max(0.0_dp,Cpool_reserve_pot - Cpool_reserve_optimal)      !! .... optimal so that there is excess carbon
mo_cbal_cpools.f90:             Cpool_reserve_pot = Cpool_reserve_pot - excess_carbon           !! .... that needs not be taken up
mo_cbal_cpools.f90:             NPP_2_greenPool = NPP_2_greenPool + excess_carbon               !! .... but can better be used to increase the green
mo_cbal_cpools.f90:             NPP_2_reservePool = NPP_2_reservePool - excess_carbon           !! .... pool and the actual amount of NPP put to the
mo_cbal_cpools.f90:          excess_carbon = max(0.0_dp,Cpool_green_pot - Cpool_green_max)      !! .. Thereby it may get larger than appropriate for 
mo_cbal_cpools.f90:          NPP_2_greenPool = NPP_2_greenPool - excess_carbon                  !! .. Hence the actual amount of NPP put to the green
mo_cbal_cpools.f90:          Cpool_green_pot = Cpool_green_pot - excess_carbon                  !! .. This excess carbon needs not be taken up but
mo_cbal_cpools.f90:             Cpool_reserve_pot = Cpool_reserve_pot + excess_carbon           !! .... it is tried to put the carbon there,
mo_cbal_cpools.f90:             NPP_2_reservePool = NPP_2_reservePool + excess_carbon           !! .... which means that additional NPP is put to the 
mo_cbal_cpools.f90:             excess_carbon =                                          &      !! .... Thereby it may happen that the reserve pool
mo_cbal_cpools.f90:             Cpool_reserve_pot = Cpool_reserve_pot - excess_carbon           !! .... In that case the excess carbon is once more
mo_cbal_cpools.f90:             NPP_2_reservePool = NPP_2_reservePool - excess_carbon           !! .... so that the actual amount of NPP put into the
mo_cbal_cpools.f90:          excess_NPP = excess_carbon / sec_per_day
mo_cbal_cpools.f90:       !! ============== START OF POTENTIAL LITTER-CARBON ALLOCATION ==============================================
mo_cbal_cpools.f90:       !! ============== use nitrogen from N mobile pool to satisfy (at least partly) for potential carbon fluxes ===
mo_cbal_cpools.f90:       Cflx_NPP_2_green_pot          = NPP_2_greenPool                                       !! potential growth of green carbon 
mo_cbal_cpools.f90:       Cflx_NPP_2_wood_pot           = NPP_2_woodPool                                        !! potential growth of wood carbon 
mo_cbal_cpools.f90:       Cflx_NPP_2_reserve_pot        = NPP_2_reservePool                                     !! potential growth of reserve carbon
mo_cbal_cpools.f90:          ! Consider a pool of organic carbon with N-content N and C-content C. Assume an influx of (organic) C called c1 associated
mo_cbal_cpools.f90:          ! with a N-influx called n1. Assume further two Carbon outfluxes, an organic one called c2 associated with a N-outflux n2,
mo_cbal_cpools.f90:          ! and a mineral Carbon outflux called c0.
